# Postgres connection string, e.g. postgres://user:password@localhost:5432/appdb?sslmode=disable
DATABASE_URL=

# Path to a Firebase service account JSON key (used by the Firebase Admin SDK).
# Do not commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

PORT=8080

# Origin allowed to make cross-origin requests to this API (the frontend dev server)
CORS_ALLOWED_ORIGIN=http://localhost:5173
